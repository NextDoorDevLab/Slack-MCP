{
  "name": "slack_mcp",
  "version": "0.1.0",
  "description": "Generic MCP server for sending and reading Slack messages as yourself, across multiple workspaces, with directory-based workspace selection.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "slack",
    "claude",
    "claude-code",
    "llm-tools",
    "ai-agent"
  ],
  "homepage": "https://github.com/NextDoorDevLab/slack_mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NextDoorDevLab/slack_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/NextDoorDevLab/slack_mcp/issues"
  },
  "mcpName": "io.github.nextdoordevlab/slack-mcp",
  "type": "module",
  "license": "MIT",
  "bin": {
    "slack-mcp": "./dist/index.js",
    "slack-mcp-authorize": "./dist/authorize.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "daemon": "tsx daemon/socket-listener.ts",
    "authorize": "tsx src/authorize.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@slack/socket-mode": "^2.0.2",
    "@slack/web-api": "^7.8.0",
    "ignore": "^6.0.2",
    "open": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
